{
  "name": "mypaseo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "daemon": "paseo daemon run",
    "test": "node --test 'src/**/*.test.ts'",
    "knip": "knip",
    "cpd": "jscpd",
    "deps": "depcruise src paseo-plugin",
    "check": "tsc -b && oxlint && knip && jscpd --silent && depcruise src paseo-plugin && node scripts/check-case.mjs && node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@getpaseo/client": "^0.11.2",
    "@getpaseo/highlight": "^0.11.2",
    "@getpaseo/protocol": "^0.11.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@getpaseo/cli": "^0.11.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
