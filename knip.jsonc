{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The vite and node test plugins find src/main.tsx and src/**/*.test.ts; the daemon loads the plugin.
  "entry": ["paseo-plugin/index.server.ts"],
  // The daemon (@getpaseo/server) provides these to the plugin at runtime.
  "ignoreDependencies": ["@getpaseo/plugin", "zod"],
  // Every issue type, including the opt-in ones: circular imports (cycles) and unused members of namespace imports
  // (`import * as git from './git'`).
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "enumMembers",
    "namespaceMembers",
    "duplicates",
    "catalog",
    "catalogReferences",
    "cycles"
  ],
  // Cycles only warn by default.
  "rules": { "cycles": "error" }
}
