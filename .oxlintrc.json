{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-properties": [
      "error",
      { "property": "invokePluginRpc", "message": "Call a daemon plugin through its only client: src/git.ts (mypaseo-git) or src/rooms.ts (mypaseo-rooms)." }
    ]
  },
  "overrides": [{ "files": ["src/git.ts", "src/rooms.ts"], "rules": { "no-restricted-properties": "off" } }]
}
